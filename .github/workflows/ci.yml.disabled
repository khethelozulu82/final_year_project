name: CI

# Runs basic checks on every PR into develop/main.
# Customize the "build" steps for your actual tech stack (Python, Node, etc.)

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop, main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
